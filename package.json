{
  "name": "ultimattt",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tic Tac Toe: Classic, Ultimate and 3D Cube variants. Installable, offline-first PWA.",
  "engines": {
    "node": ">=22.18"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "svelte-kit sync && vite dev",
    "preview": "node scripts/build.mjs && http-server build -p 8080",
    "build": "node scripts/build.mjs",
    "typecheck": "svelte-kit sync && svelte-check --fail-on-warnings && tsc -p tsconfig.tests.json",
    "test:unit": "node --test \"tests/unit/*.test.ts\"",
    "test:contract": "node --test \"tests/contract/*.test.ts\"",
    "test:e2e": "playwright test",
    "test:e2e:quick": "node scripts/e2e.mjs quick",
    "test:e2e:heavy": "node scripts/e2e.mjs heavy",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "test": "npm run typecheck && npm run test:unit && npm run test:contract",
    "check": "node scripts/check-sw.mjs && node scripts/check-build.mjs && node scripts/check-core-purity.mjs && node scripts/check-no-dom-builders.mjs --final && node scripts/check-theme.mjs && node scripts/check-theme-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-breakpoints.mjs && node scripts/check-names.mjs",
    "audit": "node scripts/audit.mjs",
    "audit:quick": "node scripts/audit.mjs --skip-perf",
    "test:parity": "playwright test -c playwright.parity.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.10.0",
    "axe-core": "^4.10.0",
    "chrome-launcher": "^1.2.2",
    "http-server": "^14.1.1",
    "lighthouse": "^12.3.0",
    "svelte": "5.57",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  }
}
